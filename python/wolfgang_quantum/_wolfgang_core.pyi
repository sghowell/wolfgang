from collections.abc import Iterable, Mapping, Sequence
from typing import Any, Literal, overload

import numpy as np
import numpy.typing as npt

class DeviceCommutationMatrix:
    @staticmethod
    def empty(shape: tuple[int, int], device: int = ..., backend: str | None = ...) -> DeviceCommutationMatrix: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    @property
    def device(self) -> int: ...
    @property
    def backend(self) -> Literal["cuda", "hip", "metal"]: ...
    @property
    def dtype(self) -> Literal["uint8"]: ...
    @property
    def num_entries(self) -> int: ...
    def to_host(self) -> npt.NDArray[np.bool_]: ...
    @overload
    def count_commuting(self, axis: None = ...) -> int: ...
    @overload
    def count_commuting(self, axis: Literal[0, 1]) -> npt.NDArray[np.uint64]: ...
    @overload
    def conflict_degrees(self, axis: None = ...) -> int: ...
    @overload
    def conflict_degrees(self, axis: Literal[0, 1]) -> npt.NDArray[np.uint64]: ...
    def __dlpack__(self, stream: int | None = ..., max_version: tuple[int, int] | None = ..., copy: bool | None = ...) -> Any: ...
    def __dlpack_device__(self) -> tuple[int, int]: ...

class DeviceArrayView:
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def dtype(self) -> Literal["uint64", "complex128"]: ...
    def __dlpack__(self, stream: int | None = ..., max_version: tuple[int, int] | None = ..., copy: bool | None = ...) -> Any: ...
    def __dlpack_device__(self) -> tuple[int, int]: ...
    @property
    def __cuda_array_interface__(self) -> dict[str, Any]: ...

class DevicePauliSum:
    @staticmethod
    def from_device_arrays(x: Any, z: Any, coeffs: Any, num_qubits: int, device: int = ...) -> DevicePauliSum: ...
    @property
    def num_qubits(self) -> int: ...
    @property
    def num_terms(self) -> int: ...
    @property
    def device(self) -> int: ...
    @property
    def backend(self) -> Literal["cuda", "hip", "metal"]: ...
    def to_host(self) -> PauliSum: ...
    def device_arrays(self) -> tuple[DeviceArrayView, DeviceArrayView, DeviceArrayView]: ...
    def simplify(self, atol: float = ..., rtol: float = ...) -> DevicePauliSum: ...
    def expectation_statevector(self, psi: Any) -> complex: ...
    def commutes_with(self, other: DevicePauliSum, max_commutation_matrix_entries: int = ...) -> bool | npt.NDArray[np.bool_]: ...
    def commutes_with_device(self, other: DevicePauliSum, max_commutation_matrix_entries: int = ..., output: DeviceCommutationMatrix | None = ...) -> DeviceCommutationMatrix: ...
    def commutes_with_into(self, other: DevicePauliSum, output: npt.NDArray[np.bool_], max_commutation_matrix_entries: int = ...) -> None: ...
    def matmul(self, rhs: DevicePauliSum, simplify: bool = ..., max_intermediate_terms: int = ...) -> DevicePauliSum: ...

class PauliSum:
    def __init__(self, num_qubits: int, num_terms: int = ...) -> None: ...
    @staticmethod
    def empty(num_qubits: int) -> PauliSum: ...
    @staticmethod
    def from_labels(labels: Iterable[str], coeffs: Any | None = ...) -> PauliSum: ...
    @staticmethod
    def from_sparse_list(triples: Iterable[tuple[str, Sequence[int], complex]], num_qubits: int) -> PauliSum: ...
    @staticmethod
    def from_qiskit(op: Any) -> PauliSum: ...
    @staticmethod
    def from_openfermion(op: Any, num_qubits: int | None = ...) -> PauliSum: ...
    @staticmethod
    def from_cudaq(op: Any, num_qubits: int | None = ...) -> PauliSum: ...
    @staticmethod
    def from_arrays(x: npt.ArrayLike, z: npt.ArrayLike, coeffs: npt.ArrayLike, num_qubits: int) -> PauliSum: ...
    @property
    def num_qubits(self) -> int: ...
    @property
    def num_terms(self) -> int: ...
    def to_labels(self) -> tuple[list[str], npt.NDArray[np.complex128]]: ...
    def to_sparse_list(self) -> list[tuple[str, list[int], complex]]: ...
    def to_arrays(
        self,
    ) -> tuple[npt.NDArray[np.uint64], npt.NDArray[np.uint64], npt.NDArray[np.complex128]]: ...
    def to_qiskit(self) -> Any: ...
    def to_openfermion(self) -> Any: ...
    def to_cudaq(self) -> Any: ...
    def simplify(self, atol: float = ..., rtol: float = ...) -> PauliSum: ...
    def matmul(self, rhs: PauliSum, simplify: bool = ..., max_intermediate_terms: int = ...) -> PauliSum: ...
    def commutes_with(self, other: PauliSum, max_commutation_matrix_entries: int = ...) -> bool | npt.NDArray[np.bool_]: ...
    def group_commuting(self, mode: Literal["qwc", "full"] = ..., strategy: Literal["largest_first"] = ..., max_terms_for_graph: int = ...) -> list[PauliSum]: ...
    def expectation_statevector(self, psi: Any) -> complex | npt.NDArray[np.complex128]: ...
    def variance_statevector(self, psi: Any) -> float | npt.NDArray[np.float64]: ...
    def apply_statevector(self, psi: Any) -> npt.NDArray[np.complex128]: ...
    def to_matrix(self, sparse: bool = ..., max_entries: int = ...) -> Any: ...
    def expectation_z_counts(self, counts: Mapping[str, float]) -> complex: ...
    def estimate_counts(self, counts: Mapping[str, float], basis: str | None = ...) -> tuple[complex, float]: ...
    def qwc_basis(self) -> str: ...
    def diagonalizing_clifford(self) -> tuple[list[tuple[str, tuple[int, ...]]], PauliSum]: ...
    def to_device(self, device: int = ..., backend: Literal["auto", "cuda", "hip", "metal"] | None = ...) -> DevicePauliSum: ...
    def __add__(self, rhs: PauliSum) -> PauliSum: ...
    def __sub__(self, rhs: PauliSum) -> PauliSum: ...
    def __neg__(self) -> PauliSum: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: int | slice) -> PauliSum: ...
    def __eq__(self, other: object) -> bool: ...
    __hash__: None  # type: ignore[assignment]
    def equiv(self, other: PauliSum, atol: float = ..., rtol: float = ...) -> bool: ...
    def adjoint(self) -> PauliSum: ...
    def commutator(self, other: PauliSum, simplify: bool = ..., max_intermediate_terms: int = ...) -> PauliSum: ...
    def anticommutator(self, other: PauliSum, simplify: bool = ..., max_intermediate_terms: int = ...) -> PauliSum: ...
    def __mul__(self, scalar: complex) -> PauliSum: ...
    def __rmul__(self, scalar: complex) -> PauliSum: ...
    def __matmul__(self, rhs: PauliSum) -> PauliSum: ...

def cuda_available() -> bool: ...
def set_num_threads(threads: int) -> None: ...
def get_num_threads() -> int: ...
def cuda_devices() -> list[dict[str, Any]]: ...
def hip_available() -> bool: ...
def hip_devices() -> list[dict[str, Any]]: ...
def metal_available() -> bool: ...
def metal_devices() -> list[dict[str, Any]]: ...
def _build_info() -> dict[str, Any]: ...
def _cuda_status() -> dict[str, Any]: ...
def _hip_status() -> dict[str, Any]: ...
def _metal_status() -> dict[str, Any]: ...
